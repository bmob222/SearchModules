    + limit (optional, number) - Number of results (default: 10, max: 50)

+ Request
    + Headers
            Content-Type: application/json
            simkl-api-key: your_api_key

+ Response 200 (application/json)
    + Body
            [
                {
                    "rank": 1,
                    "title": "Attack on Titan",
                    "year": 2013,
                    "ids": {
                        "simkl": 8691
                    },
                    "poster": "https://simkl.in/posters/8691_m.jpg",
                    "watchers": 12847
                }
            ]

